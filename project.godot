; Engine configuration file.
config_version=5

[application]
config/name="Monster Merge"
config/description="Hatch mysterious eggs, merge magical monsters, earn coins, complete daily missions and evolve eight legendary creatures in a colorful portrait mobile adventure."
config/icon="res://icon.png"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/quit_on_go_back=false

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.42, 0.78, 0.96, 1)

[boot_splash]
show_image=false
bg_color=Color(0.02, 0.02, 0.05, 1)

[autoload]

SoundManager="*res://scripts/sound_manager.gd"
MusicManager="*res://scripts/music_manager.gd"
VoiceManager="*res://scripts/voice_manager.gd"
